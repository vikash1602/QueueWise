# QueueWise backend — local development environment.
# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=queuewise
DB_USER=queuewise_app
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5433

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WebSocket channel layer. "1" uses the in-process memory layer (single
# process dev). In production set to 0 and provide REDIS_URL.
USE_INMEMORY_CHANNEL_LAYER=1
REDIS_URL=redis://127.0.0.1:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
QUEUEWISE_SEND_EMAIL_NOTIFICATIONS=0

ESTIMATION_HISTORY_SIZE=10
